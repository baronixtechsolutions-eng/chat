PORT=4000
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
FRONTEND_URL=http://localhost:3000
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
SESSION_TTL_SECONDS=86400
# true only when the app is served over HTTPS
COOKIE_SECURE=false
